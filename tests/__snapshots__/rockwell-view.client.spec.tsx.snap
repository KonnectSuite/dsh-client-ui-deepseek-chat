exports[`presents optional sign-in without claiming authenticated account access 1`] = `"<section class="_overlay_6951ae" data-active="true" aria-hidden="false"><header class="_resourceToolbar_6951ae"><span class="_title_6951ae">Rockwell Resources</span><button type="button" class="_button_4d2f85 _ghost_4d2f85 _sm_4d2f85">Connect Rockwell</button><button type="button" class="_button_4d2f85 _ghost_4d2f85 _sm_4d2f85">Download Center</button><button type="button" class="_button_4d2f85 _ghost_4d2f85 _sm_4d2f85">Sample Code</button><button type="button" class="_button_4d2f85 _ghost_4d2f85 _sm_4d2f85" disabled="">Back</button><button type="button" class="_button_4d2f85 _ghost_4d2f85 _sm_4d2f85" disabled="">Forward</button><button type="button" class="_button_4d2f85 _ghost_4d2f85 _sm_4d2f85" disabled="">Reload</button><button type="button" class="_button_4d2f85 _ghost_4d2f85 _sm_4d2f85">Disconnect / Clear session</button></header><p class="_resourceHint_6951ae" role="status">Rockwell browser disconnected</p><p class="_resourceHint_6951ae">Sign in directly on Rockwell’s website. Knowledgebase and software access depend on your account. Arya can use the visible browser through desktop computer-use tools. Downloads ask where to save.</p><div class="_resourceToolbar_6951ae"><button type="button" class="_button_4d2f85 _ghost_4d2f85 _sm_4d2f85">Enable remembered Playwright sign-in</button><span class="_status_6951ae" role="status">Playwright uses temporary browser sessions</span></div><p class="_resourceHint_6951ae">After changing this setting, start a new chat and ask Arya to open Rockwell Knowledgebase using Playwright. Sign in yourself in the visible browser. One live chat can use the saved profile at a time. This embedded page has a separate login; clearing it does not erase Playwright’s saved login.</p><div id=":R0:" class="_viewport_6951ae" aria-label="Rockwell Resources"></div></section>"`;
